<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>MkTeX</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>MkTeX</PackageId>
    <Description>Native LaTeX math typesetting for .NET: TeX layout rules on OpenType MATH metrics, with a bundled STIX Two Math font, a platform-neutral drawing model and an SVG renderer.</Description>
    <PackageTags>latex;tex;math;typesetting;opentype;svg</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\STIXTwoMath-Regular.ttf" LogicalName="MkTeX.STIXTwoMath-Regular.ttf" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="Fonts\OFL.txt" Pack="true" PackagePath="\fonts\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MkTeX.Tests" />
  </ItemGroup>
</Project>
